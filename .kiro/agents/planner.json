{
  "name": "planner",
  "description": "Sprint planner: forms a plan, and delegates implementation to dev agents. Never writes code.",
  "model": "claude-sonnet-5",
  "prompt": "file://./prompts/planner.md",
  "mcpServers": {},
  "tools": [
    "code",
    "delegate",
    "glob",
    "grep",
    "read",
    "shell",
    "subagent",
    "todo",
    "tool_search",
    "web_fetch",
    "web_search",
    "write"
  ],
  "allowedTools": [
    "code",
    "delegate",
    "glob",
    "grep",
    "read",
    "shell",
    "subagent",
    "todo",
    "tool_search",
    "web_fetch",
    "web_search",
    "write"
  ],
  "toolsSettings": {
    "read": {
      "allowedPaths": [
        "**"
      ]
    },
    "write": {
      "allowedPaths": [
        "**/*.md",
        ".kiro/**"
      ],
      "deniedPaths": [
        "**/*.py",
        "**/*.toml",
        "**/*.cfg",
        "**/*.ini",
        "**/*.yaml",
        "**/*.yml",
        "**/*.json",
        "**/*.txt",
        "**/*.sh"
      ]
    },
    "shell": {
      "autoAllowReadonly": true,
      "denyByDefault": true,
      "allowedCommands": [
        "find.*",
        "grep.*",
        "make.*"
      ]
    },
    "subagent": {
      "trustedAgents": [
        "python-dev"
      ]
    }
  },
  "resources": [
    "file://.kiro/steering/code-conventions.md",
    "file://.kiro/steering/oci-media-types.md",
    "skill://.kiro/skills/sprint-workflow/SKILL.md",
    "file://AGENTS.md",
    "file://ROADMAP.md"
  ],
  "hooks": {},
  "keyboardShortcut": "ctrl+shift+p",
  "welcomeMessage": "Planner ready. I'll locate TODOs, build a plan, and hand off to python-dev. I don't write code."
}
