{
  "name": "python-dev",
  "description": "Senior Python developer agent for building tooling.",
  "model": "claude-haiku-4.5",
  "prompt": "file://./prompts/python-dev.md",
  "mcpServers": {},
  "tools": [
    "*"
  ],
  "toolAliases": {},
  "allowedTools": [
    "code",
    "fs_read",
    "fs_write",
    "glob",
    "grep",
    "tool_search",
    "delegate",
    "knowledge",
    "todo"
  ],
  "resources": [
    "file://.kiro/steering/code-conventions.md",
    "file://AGENTS.md",
    "skill://~/.kiro/skills/*/SKILL.md"
  ],
  "hooks": {},
  "toolsSettings": {
    "read": {
      "allowedPaths": [
        "**"
      ]
    },
    "write": {
      "allowedPaths": [
        "**"
      ]
    },
    "execute_bash": {
      "autoAllowReadonly": true,
      "allowedCommands": [
        "diff.*",
        "find . .*",
        "gh.*",
        "git.*",
        "grep.*",
        "ls.*",
        "make.*",
        "pdm.*",
        "podman.*",
        "sed.*",
        "source .venv/bin/activate.*",
        "timeout.*",
        "true.*",
        "uv.*"
      ]
    }
  },
  "includeMcpJson": true
}
