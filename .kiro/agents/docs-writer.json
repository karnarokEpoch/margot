{
  "name": "docs-writer",
  "description": "Maintains the MkDocs documentation site under docs/. Writes and edits doc content, mkdocs.yml nav, and verifies builds. Never touches Python source.",
  "model": "claude-sonnet-4.6",
  "prompt": "file://./prompts/docs-writer.md",
  "mcpServers": {},
  "tools": [
    "read",
    "write",
    "grep",
    "glob",
    "code",
    "shell",
    "todo"
  ],
  "allowedTools": [
    "read",
    "grep",
    "glob",
    "code",
    "todo"
  ],
  "toolsSettings": {
    "read": {
      "allowedPaths": [
        "**"
      ]
    },
    "write": {
      "allowedPaths": [
        "docs/**",
        "mkdocs.yml",
        "*.md",
        ".kiro/steering/documentation.md"
      ],
      "deniedPaths": [
        "**/*.py",
        "src/**",
        "tests/**",
        "pyproject.toml",
        "uv.lock"
      ]
    },
    "shell": {
      "autoAllowReadonly": true,
      "denyByDefault": true,
      "allowedCommands": [
        "make.*",
        "uv.*",
        "git.*"
      ]
    }
  },
  "resources": [
    "file://.kiro/steering/documentation.md",
    "file://.kiro/steering/oci-media-types.md",
    "file://ROADMAP.md",
    "file://AGENTS.md"
  ],
  "hooks": {},
  "includeMcpJson": true,
  "welcomeMessage": "docs-writer ready. I maintain docs/ as the standing source of truth for shipped behavior. I don't touch source code."
}
